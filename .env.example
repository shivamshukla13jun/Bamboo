# MongoDB Connection String
MONGODB_URI="mongodb://localhost:27017/bamboorise"

# File Storage Provider (server-side only, never exposed to the app)
# Options: mock | aws | cloudinary
# mock = real local file upload to public/uploads served at /uploads/*
# aws / cloudinary = simulated URLs
STORAGE_PROVIDER="mock"

# AWS S3 (simulated when STORAGE_PROVIDER=aws)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="bamboorise-uploads"

# Cloudinary (simulated when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME="bamboorise-cloud"

# Auth
# Secret used to sign session cookies — change in production
AUTH_SECRET="change-me-in-production"
# Seeded admin account credentials
ADMIN_EMAIL="admin@bamboorise.com"
ADMIN_PASSWORD="admin123"
