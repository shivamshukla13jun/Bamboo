# MongoDB Connection String
MONGODB_URI="mongodb://localhost:27017/bamboorise"

# File Storage Provider: mock | aws | cloudinary | minio
# mock = real local file upload to public/uploads served at /uploads/*
# aws / cloudinary / minio = simulated URLs
STORAGE_PROVIDER="mock"

# AWS S3 (simulated when STORAGE_PROVIDER=aws)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="bamboorise-uploads"

# Cloudinary (simulated when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME="bamboorise-cloud"

# MinIO (simulated when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT="play.min.io:9000"
MINIO_BUCKET="bamboorise-bucket"
